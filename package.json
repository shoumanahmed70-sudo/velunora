{
  "name": "velunora",
  "version": "1.0.0",
  "private": true,
  "description": "VELUNORA - متجر عطور فاخر متكامل (Next.js + Firebase مع محرك تخزين محلي للتطوير)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "admin:create": "node scripts/create-admin.mjs",
    "seed": "node scripts/seed.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "share": "tools/cloudflared.exe tunnel --url http://localhost:3000 --protocol http2 --no-autoupdate"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.58.0",
    "next": "15.5.28",
    "nodemailer": "^10.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
