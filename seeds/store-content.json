  "pages": [
    {
      "slug": "about",
      "title": "من نحن",
      "titleEn": "About us",
      "content": "نحن متجر عطور متخصص يختار تركيباته بعناية لتمنحك تجربة عطرية فاخرة تدوم. نعمل مع موردين موثوقين ونضمن أصالة كل زجاجة.",
      "contentEn": "We are a specialised fragrance house curating compositions for a luxurious, lasting experience, sourced from trusted partners.",
      "updatedAt": 1792143209023
    },
    {
      "slug": "privacy",
      "title": "سياسة الخصوصية",
      "titleEn": "Privacy policy",
      "content": "نحفظ بياناتك (الاسم، الجوال، العنوان) لأغراض تنفيذ الطلبات والتواصل فقط، ولا نشاركها مع أي طرف غير مكلف بالتوصيل. لا ننشر بيانات العملاء أو طلباتهم للعامة.",
      "contentEn": "We store your data (name, phone, address) only to fulfil orders and communicate with you; we never share it beyond delivery partners.",
      "updatedAt": 1792143209023
    },
    {
      "slug": "terms",
      "title": "الشروط والأحكام",
      "titleEn": "Terms & conditions",
      "content": "بإتمام الطلب فإنك توافق على صحة البيانات المدخلة، ويحق للمتجر تأكيد الطلب هاتفيًا قبل التجهيز. الأسعار المعروضة نهائية وتشمل ما هو موضح في ملخص الطلب.",
      "contentEn": "By placing an order you confirm the accuracy of the submitted data; the store may confirm by phone before processing.",
      "updatedAt": 1792143209023
    },
    {
      "slug": "shipping",
      "title": "سياسة الشحن",
      "titleEn": "Shipping policy",
      "content": "يتم تجهيز الطلبات خلال 24 ساعة من التأكيد، ويستغرق التوصيل داخل المدينة 1–2 يوم وفي باقي المناطق 2–4 أيام عمل.",
      "contentEn": "Orders are prepared within 24 hours of confirmation; delivery takes 1–2 days locally and 2–4 business days nationwide.",
      "updatedAt": 1792143209023
    },
    {
      "slug": "returns",
      "title": "سياسة الاسترجاع",
      "titleEn": "Returns policy",
      "content": "يمكن طلب الاستبدال أو الاسترجاع خلال 3 أيام من الاستلام بشرط أن يكون المنتج مغلقًا وبحالته الأصلية، مع إرفاق رقم الطلب.",
      "contentEn": "Exchange or return can be requested within 3 days of delivery provided the product is sealed and in original condition.",
      "updatedAt": 1792143209023
    }
