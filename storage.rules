rules_version = '2';

// ============================================================================
// VELUNORA — قواعد Cloud Storage
// ----------------------------------------------------------------------------
// الصور (المنتجات/البانرات/الشعار) تُرفع من الخادم فقط عبر Admin SDK.
// نسمح بالقراءة العامة لصور المتجر (لعرضها في الصفحات)، ونمنع أي كتابة من العميل.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // صور المتجر المرفوعة من لوحة الإدارة (velunora/product|banner|logo|home|...)
    match /velunora/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // أي مسار آخر: ممنوع تمامًا.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
