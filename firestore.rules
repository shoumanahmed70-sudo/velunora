rules_version = '2';

// ============================================================================
// VELUNORA — قواعد Firestore
// ----------------------------------------------------------------------------
// مبدأ الأمان: لا يتصل أي عميل (متصفح) بـ Firestore مباشرة إطلاقًا.
// كل قراءة/كتابة تمر عبر واجهات الـ API على الخادم باستخدام Firebase Admin SDK،
// والذي يتجاوز هذه القواعد. لذلك نُغلق كل الوصول المباشر من العميل.
//
// هذا يمنع بشكل قاطع:
//   - تغيير أسعار المنتجات أو الخصومات من المتصفح.
//   - تغيير حالة الطلب أو تعديل الطلبات.
//   - منح صلاحيات مدير أو تعديل سجل admins.
//   - قراءة بيانات عملاء آخرين.
//
// (المصادقة عبر Firebase Authentication لإشارة Google فقط؛ الجلسة تُدار بكوكي
//  HttpOnly موقّع على الخادم.)
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // مساعد اختياري للاستخدام المستقبلي في حال فُتح وصول مباشر محدود.
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // إغلاق كامل: لا وصول مباشر من العملاء إلى أي مجموعة.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
