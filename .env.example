# ============================================================
# VELUNORA — ملف إعدادات البيئة (انسخه إلى .env.local)
# ============================================================
# قاعدة التخزين: "local" = محرك محلي للتطوير (يعمل فورًا بلا مفاتيح)
#                "firebase" = بيئة الإنتاج عبر Firebase
# ============================================================
STORAGE_DRIVER=local

# ---------- إلزامي في الإنتاج ----------
# مفتاح سري لتوقيع جلسات تسجيل الدخول (كوّن قيمة عشوائية طويلة 32+ بايت)
# استخدم: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# الرابط العام للمتجر — إلزامي في الإنتاج (NODE_ENV=production)
# يُبنى عليه روابط البريد (التحقق من الحساب / إعادة تعيين كلمة المرور / الفاتورة)
# ويمنع "تسميم الروابط" عبر ترويسة Host. مثال: https://velunora.com
# في التطوير فقط يمكن تركه فارغًا فيُستخدم مضيف الطلب الحالي تلقائيًا.
APP_URL=

# مفتاح تشفير إعدادات المتجر الحسّاسة (كلمة سر SMTP) — إلزامي إن استخدمت SMTP
# تشفير AES-256-GCM. استخدم: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# عدد الوسطاء الموثوقين أمام الخادم (لقراءة عنوان العميل من x-forwarded-for)
# 0 = لا تثق بالترويسة (استخدم x-real-ip أو "local") — مناسب للتشغيل المباشر
# 1 = خلف وكيل/موازن واحد موثوق (مثل Vercel أو nginx محلي)
TRUSTED_PROXY_HOPS=0

# ---------- Firebase (مطلوب عند STORAGE_DRIVER=firebase) ----------
# احصل عليها من: Firebase Console -> Project settings -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# حساب الخدمة (Service Account) — من:
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
# احفظ الملف بأمان خارج المستودع، ثم ضع مساره هنا أو الصق محتواه في FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---------- تفعيل تسجيل Google (اختياري) ----------
# بعد إنشاء OAuth Client في Google Cloud Console وتفعيل Google في Firebase Auth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# روابط إعادة التعيين في وضع التطوير فقط (قيمة خادمة غير عامة — تُقرأ وقت التشغيل)
# تظهر فقط مع `npm run dev`. في الإنتاج (`npm start`) لا تظهر أبدًا مهما كانت القيمة.
# لاستعادة كلمة سر الأدمن بدون SMTP في الإنتاج استخدم:
#   npm run admin:create -- --email admin@... --password "..." --name "..." --role owner
VELUNORA_DEV_RESET_LINKS=true

# (مهجورة) النسخة العامة القديمة — بقيت للتوافق؛ لا تعتمد عليها خصوصًا أن
# `NEXT_PUBLIC_*` تُنسخ داخل الحزمة وقت البناء ولا تتغير بتغيير .env.local بعد البناء
NEXT_PUBLIC_ALLOW_DEV_RESET_LINKS=false
